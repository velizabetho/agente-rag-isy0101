# LLM (Groq). Cada modelo tiene su propio límite de tokens por minuto en el plan gratuito.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
PLANNER_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=qwen/qwen3.8-27b

# Embeddings
# EMBEDDING_PROVIDER: local (sentence-transformers, gratis) u openai (requiere OPENAI_API_KEY y pip install openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_API_KEY=

# MongoDB Atlas (base vectorial, memoria del agente y checkpoints)
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=clubes_lectura

# LangSmith (trazas, opcional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-rag-isy0101
